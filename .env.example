NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Banco e cache para o ambiente operacional
DATABASE_URL=postgresql://ubercar:change-me@localhost:5432/ubercar
REDIS_URL=redis://localhost:6379

# Mapas: escolha um provedor para produção
MAP_PROVIDER=osrm
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Pagamentos: nunca commitar valores reais neste arquivo
PAYMENT_PROVIDER=efi
EFI_ENVIRONMENT=homologation
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=./certs/efi-homolog.p12
EFI_CERTIFICATE_PASSWORD=
EFI_PIX_KEY=
EFI_WEBHOOK_HMAC=

# Armazenamento de documentos em produção
STORAGE_PROVIDER=local
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=driver-documents

# Autenticação e sessões
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@016ubercar.local
ADMIN_PASSWORD=change-me-in-production
